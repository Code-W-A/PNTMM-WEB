rules_version = '2';

// =============================================================================
// PNȚMM Cluj — reguli Cloud Storage
//
// Accesul clientului (SDK Firebase) este refuzat integral. Încărcarea se face
// exclusiv prin API-ul server-side cu Admin SDK:
//
// - Fotografiile sesizărilor rămân private (`reports/...`) și se citesc numai
//   prin URL semnat cu expirare scurtă, pentru administratori.
// - Coperțile de știri și evenimente (`content/...`) sunt făcute publice de
//   Admin SDK (ACL GCS). Regulile de mai jos nu se aplică URL-ului public
//   storage.googleapis.com; vizitatorii nu au totuși drept de scriere.
//
// Numele fișierelor sunt generate server-side, niciodată preluate de la client.
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
