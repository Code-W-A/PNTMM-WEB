# =============================================================================
# PNȚMM Cluj — variabile de mediu
# Copiați acest fișier ca .env.local și completați valorile.
# NU adăugați valori reale în acest fișier: este versionat.
# Folosiți proiecte Firebase DIFERITE pentru development și production.
# =============================================================================

# --- Site --------------------------------------------------------------------
# Domeniul oficial, fără slash final. Ex: https://exemplu.ro
NEXT_PUBLIC_SITE_URL=

# --- Firebase: configurație publică pentru client -----------------------------
# Firebase Console > Project settings > General > Your apps > Web app > SDK setup
# Aceste valori NU sunt secrete; accesul este controlat de reguli și de API-ul server.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin: SECRETE, exclusiv server-side ----------------------------
# Firebase Console > Project settings > Service accounts > Generate new private key
# NU prefixați niciodată aceste variabile cu NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Cheia privată completă, între ghilimele, cu \n pentru linii noi.
FIREBASE_PRIVATE_KEY=
# Ex: proiect-id.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# --- App Check ----------------------------------------------------------------
# reCAPTCHA v3 site key. Lăsați gol până la configurarea App Check în Console.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# "monitor" pentru observare fără blocare, "enforce" pentru respingerea cererilor.
APPCHECK_MODE=monitor

# --- Expo Push (secret opțional, exclusiv server-side) ------------------------
# Token de acces Expo atunci când proiectul EAS are push security activat.
# Nu folosiți prefixul NEXT_PUBLIC_ și nu copiați valoarea în aplicația mobilă.
EXPO_ACCESS_TOKEN=

# --- Porți funcționale ---------------------------------------------------------
# Activează trimiterea reală a formularelor din interfață.
NEXT_PUBLIC_FORMS_ENABLED=true
# Poarta pentru colectarea de date reale. Pe "false", trimiterile sunt persistate,
# dar marcate ca date de test, iar interfața anunță explicit acest lucru.
# Puneți "false" doar în mediul de development, ca datele de probă să nu se
# amestece cu cele reale.
REAL_DATA_COLLECTION_ENABLED=true

# --- Emulatori Firebase (doar development local) ------------------------------
# Decomentați când rulați `npm run emulators`.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
